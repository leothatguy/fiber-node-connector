{
  "name": "fiber-node-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outbound Docker agent that safely connects a private Fiber node to a remote application backend.",
  "exports": {
    "./server": "./src/server/index.js",
    "./protocol": "./src/protocol.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "LOG_LEVEL=debug node --watch src/index.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "example:backend": "node examples/reference-backend/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
