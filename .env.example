BACKEND_URL=https://api.example.com
CONNECTOR_TOKEN=replace-with-a-random-secret
CONNECTOR_ID=merchant-ckb-address-or-stable-id

FIBER_RPC_URL=http://127.0.0.1:8227
# FIBER_RPC_BEARER_TOKEN=

# Hardcoded maximum capabilities can only be reduced, never expanded.
CONNECTOR_ALLOWED_METHODS=node_info,list_channels,new_invoice,get_invoice

CONNECTOR_HEARTBEAT_MS=10000
CONNECTOR_POLL_MS=1500
CONNECTOR_BACKEND_TIMEOUT_MS=15000
FIBER_RPC_TIMEOUT_MS=15000
CONNECTOR_RETRY_MIN_MS=1000
CONNECTOR_RETRY_MAX_MS=30000

# HTTP backend URLs are accepted automatically only for loopback hosts.
CONNECTOR_ALLOW_INSECURE_BACKEND=false
CONNECTOR_INCLUDE_NODE_ADDRESSES=true
LOG_LEVEL=info
LOG_FORMAT=pretty
